# Server-only Cleanverse credentials. Never prefix these with NEXT_PUBLIC_.
CLEANVERSE_API_BASE_URL=https://uatapi.cleanverse.com/api/cooperate
CLEANVERSE_API_ID=replace-with-sandbox-api-id
CLEANVERSE_API_KEY=replace-with-rotated-base64-sandbox-key

# Public chain configuration. Runtime discovery remains authoritative.
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadexplorer.com
NEXT_PUBLIC_MORDANT_VAULT_ADDRESS=

# Judged deployment only. Resolve every address afresh; never commit a private key.
DEPLOYER_PRIVATE_KEY=
MORDANT_BOUNDARY_OWNER=
MORDANT_FACTORY_OWNER=
CLEANVERSE_APASS_ADDRESS=
INVOICE_ATOKEN_ADDRESS=
CVI_OPEN_ROLE_MASK=16
CVI_VERIFIER_ADDRESS=
CVA_ADAPTER_ADDRESS=
SETTLEMENT_TOKEN_ADDRESS=
