{
  "name": "mordant",
  "version": "0.1.0",
  "private": true,
  "description": "The recourse layer for tokenized private credit.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:cleanverse": "tsc -p tsconfig.cleanverse-tests.json && NODE_PATH=./test/stubs node --test .cleanverse-test-dist/src/lib/cleanverse/cleanverse.test.js",
    "test:unit": "pnpm build:contracts && tsc -p tsconfig.cleanverse-tests.json && NODE_PATH=./test/stubs node --test .cleanverse-test-dist/src/lib/cleanverse/cleanverse.test.js .cleanverse-test-dist/src/lib/contracts/abi-parity.test.js .cleanverse-test-dist/src/lib/contracts/pledge.test.js .cleanverse-test-dist/src/lib/contracts/read-vault.test.js .cleanverse-test-dist/src/lib/dealroom/living-demo.test.js .cleanverse-test-dist/src/lib/evidence/chain-config.test.js .cleanverse-test-dist/src/lib/evidence/evidence.test.js .cleanverse-test-dist/src/lib/mordant/identity.test.js .cleanverse-test-dist/src/lib/private-matching/config.test.js .cleanverse-test-dist/src/lib/mordant/lexicon.test.js .cleanverse-test-dist/src/lib/mordant/product-model.test.js .cleanverse-test-dist/src/lib/mordant/readiness.test.js .cleanverse-test-dist/src/lib/mordant/scenario.test.js",
    "build:contracts": "forge build --root contracts",
    "fmt:contracts": "forge fmt --root contracts --check",
    "test:contracts": "forge test --root contracts -vvv",
    "test:e2e": "playwright test && pnpm test:e2e:public && pnpm test:e2e:direct-participant",
    "test:e2e:public": "playwright test --config playwright.public-experience.config.ts",
    "test:e2e:direct-participant": "playwright test --config playwright.direct-participant.config.ts",
    "test:e2e:visual": "playwright test --config playwright.visual.config.ts",
    "test:e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:e2e:design": "playwright test --config playwright.design.config.ts",
    "evidence:cleanverse": "tsc -p tsconfig.cleanverse-tests.json && node .cleanverse-test-dist/src/lib/evidence/cli.js",
    "test": "tsc --noEmit && pnpm test:unit && forge test --root contracts -vvv",
    "validate": "eslint . && tsc --noEmit && pnpm test:unit && pnpm test:runner && forge test --root contracts -vvv && pnpm evidence:cleanverse && pnpm secret:scan && pnpm verify:integration && pnpm fhe:test && next build --webpack",
    "validate:ci": "pnpm validate && pnpm test:e2e",
    "secret:scan": "tsc -p tsconfig.cleanverse-tests.json && node .cleanverse-test-dist/src/lib/evidence/secret-scan-cli.js",
    "audit:contrast": "node scripts/audit-mux2-contrast.mjs",
    "localnet": "node scripts/localnet.mjs",
    "localnet:deploy": "node scripts/localnet.mjs --once",
    "preflight:monad": "tsc -p tsconfig.cleanverse-tests.json && node .cleanverse-test-dist/src/lib/preflight/cli.js",
    "preflight:monad:fork": "node scripts/monad-fork-vault-check.mjs",
    "m05:dryrun": "node scripts/m05-dryrun-monad.mjs",
    "m05:check": "node scripts/m05-runner.mjs --check",
    "m05:fork": "node scripts/m05-runner.mjs --fork",
    "test:runner": "node --test scripts/runner-controls.test.mjs scripts/m05-runner.test.mjs scripts/m07-ausdc-transfer.test.mjs scripts/m08-contract-apass.test.mjs scripts/m10-custody-roundtrip.test.mjs scripts/m11-invoice-atoken-launch.test.mjs scripts/m12-adapter-path.test.mjs scripts/m13-fork.test.mjs scripts/m13b-vault-binding.test.mjs scripts/m13c-activation-terminal.test.mjs scripts/m14-manifest.test.mjs scripts/m15-phase.test.mjs scripts/m15-engine.test.mjs scripts/verify-recourse-v2-demo-config.test.mjs scripts/n2-isolation-evidence.test.mjs",
    "revalidate:ausdc": "node --env-file=.env scripts/m06-ausdc-revalidation.mjs",
    "m07:check": "node --env-file=.env scripts/m07-ausdc-transfer.mjs --check",
    "m08:check": "node --env-file=.env scripts/m08-contract-apass.mjs --check",
    "m10:check": "node --env-file=.env scripts/m10-custody-roundtrip.mjs --check",
    "m11:check": "node --env-file=.env scripts/m11-invoice-atoken-launch.mjs --check",
    "m12:inspect": "node --env-file=.env scripts/m12-adapter-path.mjs --inspect",
    "m12:apass": "node --env-file=.env scripts/m12-adapter-path.mjs --apass",
    "m12:grant": "node --env-file=.env scripts/m12-adapter-path.mjs --grant",
    "m13:control-a": "node scripts/m13-control-a.mjs",
    "m13a:ceremony": "node scripts/m13a-ceremony.mjs",
    "m13b:binding": "node scripts/m13b-vault-binding.mjs",
    "m13c:terminal": "node scripts/m13c-activation-terminal.mjs",
    "m14:manifest": "node --env-file=.env scripts/m14-manifest.mjs",
    "m15:phase": "node --env-file=.env scripts/m15-phase-runner.mjs",
    "fhe:test": "node --test fhe-lab/shared/identity/asset-identity.test.mjs fhe-lab/shared/identity/session-protocol.test.mjs fhe-lab/shared/identity/v4-digests.test.mjs fhe-lab/shared/identity/source-attestation-digest.test.mjs fhe-lab/monad-testnet/party-signer.test.mjs fhe-lab/privacy-v4/leak-scan.test.mjs fhe-lab/monad-testnet/v5-journal.test.mjs fhe-lab/monad-testnet/v5-preconditions.test.mjs fhe-lab/monad-testnet/v5-call-matrix.test.mjs fhe-lab/monad-testnet/v5-live-guard.test.mjs fhe-lab/monad-testnet/v5-stage.test.mjs fhe-lab/monad-testnet/v5-deployment-plan.test.mjs fhe-lab/monad-testnet/v5-vault-flow.test.mjs fhe-lab/monad-testnet/v5-source-flow.test.mjs fhe-lab/monad-testnet/v5-session-flow.test.mjs fhe-lab/monad-testnet/v5-journalized-runner.test.mjs fhe-lab/monad-testnet/v5-ceremony-flow.test.mjs",
    "fhe:go:test": "cd fhe-lab/lattigo && go test -timeout 30m ./...",
    "recourse-policy:test": "tsc -p tsconfig.product-tests.json && NODE_PATH=./test/stubs node --test .product-test-dist/src/lib/protection/governed-recourse-policy.test.js .product-test-dist/src/lib/protection/governed-recourse-operation.test.js",
    "protection:test": "node scripts/run-protection-tests.mjs",
    "protection:adapter": "node scripts/protection-local-adapter.mjs",
    "protection:smoke:conflict": "tsc -p tsconfig.product-tests.json && NODE_PATH=./test/stubs node .product-test-dist/src/lib/protection/product-smoke-cli.js conflict",
    "protection:smoke:no-conflict": "tsc -p tsconfig.product-tests.json && NODE_PATH=./test/stubs node .product-test-dist/src/lib/protection/product-smoke-cli.js no-conflict",
    "protection:smoke:coalition": "tsc -p tsconfig.product-tests.json && NODE_PATH=./test/stubs node scripts/coalition-live-smoke.mjs",
    "proof:n2-isolation": "tsc -p tsconfig.product-tests.json && node scripts/n2-isolated-execution-proof.mjs",
    "proof:n2-isolation:validate": "node scripts/validate-n2-isolation-evidence.mjs && node --test scripts/n2-isolation-evidence.test.mjs",
    "fhe:contracts:test": "forge test --root contracts",
    "fhe:priv8:run": "node --env-file=.env fhe-lab/monad-testnet/run-priv8.mjs",
    "verify:frozen": "node scripts/verify-frozen-sources.mjs",
    "verify:abi": "pnpm build:contracts && node scripts/verify-abi-selectors.mjs",
    "verify:hygiene": "node scripts/verify-repository-hygiene.mjs",
    "verify:integration": "pnpm verify:frozen && pnpm verify:deployed-sources && pnpm verify:abi && pnpm verify:solidity-fmt && pnpm verify:hygiene",
    "verify:solidity-fmt": "node scripts/verify-solidity-format.mjs",
    "verify:deployed-sources": "node scripts/verify-deployed-recourse-sources.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@tanstack/react-query": "5.101.4",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.8",
    "wagmi": "3.7.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "react-test-renderer": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
