      "failureMessage": "export public evidence: governed FHE binding rejected",
      "actualCause": "The Go test fixture never produced product-recourse-attestation.json, which evidence export legitimately requires. Both ExportPublicEvidence call sites therefore failed.",
      "supersededExplanation": "An earlier closure described this as environment-gated. That was wrong: identical base and head results established non-regression only, and never established a cause."
    },
    "correction": {
      "kind": "test-only",
      "change": "production_test.go now calls the production CreateRecourseAttestation before each ExportPublicEvidence call, and verifies it loads back from the public root. In no_conflict_cannot_activate_recourse it is published before the private root is taken offline, so the export itself still runs public-root-only.",
      "productionBehaviourChanged": false
    },
    "finalResult": {
      "command": "go test ./governedfhe/ -run TestGovernedFHEProductionPaths -count=1",
      "workingDirectory": "fhe-lab/lattigo",
      "prerequisite": "MORDANT_FHE_EVALUATOR_BIN and MORDANT_FHE_DECRYPTOR_BIN built from the checkout under test",
      "result": "ok"
    }
